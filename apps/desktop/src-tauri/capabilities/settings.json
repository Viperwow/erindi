{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-microphones",
    "allow-set-hotkeys-paused",
    "allow-list-sessions",
    "allow-open-history-session",
    "allow-continue-session",
    "allow-delete-session",
    "allow-model-status",
    "allow-download-model",
    "allow-test-command"
  ]
}
