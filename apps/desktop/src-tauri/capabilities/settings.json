{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-microphones",
    "allow-set-hotkeys-paused",
    "allow-list-sessions",
    "allow-open-history-session",
    "allow-continue-session",
    "allow-delete-session",
    "allow-model-status",
    "allow-download-model",
    "allow-test-command",
    "allow-default-patterns",
    "allow-agent-status",
    "allow-recheck-agents",
    "allow-has-api-key",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-api-models",
    "allow-codex-limited",
    "allow-trust-in-codex"
  ]
}
