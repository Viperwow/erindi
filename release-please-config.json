{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "668570c",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "erindi",
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='erindi-core' || @.name=='erindi-audio-asr' || @.name=='erindi-desktop')].version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" }
      ]
    }
  }
}
